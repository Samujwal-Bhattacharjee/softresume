# ─────────────────────────────────────────────────────────────────────────────
# SoftCV Studio — Environment Variables Example
# ─────────────────────────────────────────────────────────────────────────────
# SoftCV Studio runs completely in Demo / Local Mode out of the box using
# browser-based local storage (no external database or API key required).
#
# When ready to enable cloud persistence or AI assistant capabilities,
# copy this file to .env.local and configure the variables below.
# NEVER commit .env.local or secret keys into version control.
# ─────────────────────────────────────────────────────────────────────────────

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# AI Assistant Configuration (SERVER-SIDE ONLY)
# ─────────────────────────────────────────────────────────────────────────────
# AI provider calls are made strictly from server route handlers (/api/ai/*).
# Provider API keys are never bundled into client JS or exposed to the browser.
#
# Supported providers:
#   - openai (default): OpenAI API / OpenAI-compatible endpoint
#   - anthropic: Anthropic Claude API
#   - gemini: Google Gemini API
#
# Leave AI_API_KEY blank to operate in local demo mode.
# When unconfigured, the app honestly displays an informational notice and
# never fabricates fake AI results.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# ─────────────────────────────────────────────────────────────────────────────
# Optional: Supabase (for future cloud persistence & auth milestone)
# ─────────────────────────────────────────────────────────────────────────────
# Leave blank to use browser-local storage adapter (Local-first demo mode)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
